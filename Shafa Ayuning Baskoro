<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Maaf, Sayang</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Caveat:wght@500;600;700&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#5c2438;
    --ink-soft:#7a3a54;
    --rose:#f2a8bc;
    --rose-deep:#d6577a;
    --blush-bg:#ffeef3;
    --gold:#e3a9b8;
    --white:#ffffff;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:linear-gradient(180deg, var(--white), var(--blush-bg) 55%, var(--white));
    color:var(--ink);
    font-family:'Jost', sans-serif;
    font-weight:300;
    overflow-x:hidden;
    min-height:100vh;
  }
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; scroll-behavior:auto !important;}
  }

  #seal-screen{
    position:fixed; inset:0; z-index:50;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    background:radial-gradient(circle at 50% 40%, var(--blush-bg), var(--white) 75%);
    transition:opacity 1s ease, visibility 1s ease;
  }
  #seal-screen.opened{opacity:0; visibility:hidden; pointer-events:none;}
  .envelope-hint{
    font-family:'Cormorant Garamond', serif;
    font-style:italic;
    font-size:1.05rem;
    color:var(--rose-deep);
    margin-top:26px;
    letter-spacing:0.5px;
    opacity:0.85;
  }
  .seal{
    width:96px; height:96px; border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #f6b8c9, var(--rose-deep) 70%, #b53f65);
    box-shadow:0 10px 30px rgba(214,87,122,0.25), inset 0 2px 6px rgba(255,255,255,0.4);
    display:flex; align-items:center; justify-content:center;
    cursor:pointer;
    animation:pulse 2.6s ease-in-out infinite;
    border:none;
  }
  .seal svg{width:38px;height:38px;}
  @keyframes pulse{
    0%,100%{transform:scale(1); box-shadow:0 10px 30px rgba(214,87,122,0.25), 0 0 0 0 rgba(242,168,188,0.45);}
    50%{transform:scale(1.06); box-shadow:0 10px 34px rgba(214,87,122,0.3), 0 0 0 14px rgba(242,168,188,0);}
  }
  .seal.melt{animation:melt 0.9s forwards ease-in;}
  @keyframes melt{
    to{transform:scale(6); opacity:0;}
  }

  main{
    max-width:640px; margin:0 auto;
    padding:14vh 7vw 18vh;
  }
  .eyebrow{
    font-family:'Caveat', cursive;
    font-size:1.4rem;
    color:var(--rose-deep);
    display:block;
    margin-bottom:6px;
  }
  h1{
    font-family:'Cormorant Garamond', serif;
    font-weight:600;
    font-size:clamp(2.2rem, 8vw, 3.4rem);
    line-height:1.1;
    color:var(--ink);
    letter-spacing:0.3px;
  }
  h1 em{
    font-style:italic; color:var(--rose-deep);
    font-weight:500;
  }
  .divider{
    width:56px; height:1px; background:var(--gold);
    margin:34px 0; opacity:0.9;
  }

  .letter p{
    font-size:1.08rem; line-height:1.85;
    color:var(--ink-soft);
    margin-bottom:1.35em;
    opacity:0;
    transform:translateY(16px);
    transition:opacity 0.9s ease, transform 0.9s ease;
  }
  .letter p.show{opacity:1; transform:translateY(0);}
  .letter p.edit-note{
    font-size:0.78rem; color:#b5476b; font-style:italic; opacity:0.85; transform:none; background:rgba(242,168,188,0.18); padding:10px 14px; border-left:2px solid var(--gold);
  }
  .letter p.edit-note.show{opacity:0.85;}

  .signature{
    font-family:'Caveat', cursive;
    font-size:2.1rem;
    color:var(--rose-deep);
    margin-top:8px;
    opacity:0;
    transform:translateY(16px);
    transition:opacity 0.9s ease, transform 0.9s ease;
  }
  .signature.show{opacity:1; transform:translateY(0);}

  .bloom-wrap{
    display:flex; justify-content:center; margin:70px 0 10px;
  }
  .bloom{
    width:120px; height:120px;
    transform:scale(0.15);
    opacity:0.25;
    transition:transform 1.4s cubic-bezier(.2,.8,.2,1), opacity 1.4s ease;
  }
  .bloom.show{ transform:scale(1); opacity:1; }
  .petal{
    fill:var(--rose);
  }

  .ask{
    text-align:center;
    margin-top:90px;
  }
  .ask h2{
    font-family:'Cormorant Garamond', serif;
    font-style:italic;
    font-weight:500;
    font-size:clamp(1.5rem,6vw,2.1rem);
    color:var(--ink);
    margin-bottom:34px;
    opacity:0; transform:translateY(16px);
    transition:opacity 0.9s ease, transform 0.9s ease;
  }
  .ask h2.show{opacity:1; transform:translateY(0);}

  .btn-row{
    position:relative;
    display:flex; flex-direction:column; gap:16px; align-items:center;
    opacity:0; transform:translateY(16px);
    transition:opacity 0.9s ease 0.15s, transform 0.9s ease 0.15s;
    min-height:220px;
    width:100%;
    max-width:320px;
    margin:0 auto;
    padding-top:10px;
  }
  .btn-row.show{opacity:1; transform:translateY(0);}

  #yes-btn{
    position:relative; z-index:2;
    font-family:'Jost', sans-serif;
    font-size:1rem; letter-spacing:0.5px;
    padding:16px 40px;
    border-radius:40px;
    border:1px solid var(--rose-deep);
    background:linear-gradient(135deg, var(--rose), #e37b96);
    color:var(--white);
    font-weight:500;
    cursor:pointer;
    transition:transform 0.25s ease, box-shadow 0.25s ease;
    box-shadow:0 6px 20px rgba(214,87,122,0.35);
  }
  #yes-btn:hover, #yes-btn:focus-visible{transform:translateY(-2px); box-shadow:0 10px 26px rgba(214,87,122,0.4);}
  #yes-btn:active{transform:translateY(0);}

  #no-btn{
    position:absolute;
    top:70px; left:50%;
    transform:translateX(-50%);
    z-index:1;
    font-family:'Jost', sans-serif;
    font-size:0.92rem;
    background:var(--white);
    border:1px solid rgba(92,36,56,0.25);
    color:rgba(92,36,56,0.6);
    padding:12px 30px;
    border-radius:40px;
    cursor:pointer;
    white-space:nowrap;
    transition:left 0.28s ease, top 0.28s ease;
  }

  button:focus-visible{ outline:2px solid var(--rose-deep); outline-offset:3px; }

  .response{
    margin-top:34px;
    font-family:'Caveat', cursive;
    font-size:1.7rem;
    color:var(--rose-deep);
    min-height:2.4rem;
  }

  footer{
    text-align:center; padding-bottom:8vh; opacity:0.5; font-size:0.78rem; letter-spacing:0.5px; color:var(--ink);
  }
</style>
</head>
<body>

  <div id="seal-screen">
    <button class="seal" id="seal-btn" aria-label="Buka surat">
      <svg viewBox="0 0 24 24" fill="none"><path d="M12 21s-8-4.9-8-11a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6.1-8 11-8 11Z" fill="#ffffff" stroke="#ffffff" stroke-width="0.5"/></svg>
    </button>
    <span class="envelope-hint">ketuk untuk membuka surat</span>
  </div>

  <main>
    <span class="eyebrow">untuk kamu,</span>
    <h1>maaf, <em>ya</em>.</h1>
    <div class="divider"></div>

    <div class="letter">
      <p class="edit-note">Aku tahu maaf udah sering banget km denger, padahal yang aku rasain nggak segampang itu.
      <p> Aku beneran sadar udah bikin kamu kecewa, dan itu bukan hal yang aku anggap sepele.
      <p>​Aku nggak akan cari alasan buat ngebenerin apa yang udah aku lakuin. Yang aku tahu, kamu berhak dapet perlakuan yang lebih baik dari itu — dan aku minta maaf karena belum bisa kasih itu kemarin.<p>
      <p>​Aku sayang sama kamu, sama caramu ketawa, sama caramu peduli, sama semua hal kecil yang bikin hari-hariku lebih baik karena ada kamu. Aku nggak mau hal itu rusak cuma karena aku belum belajar jadi lebih baik.<p>
      ​<p>Aku janji akan lebih hati-hati jaga perasaanmu. Bukan cuma lewat kata-kata, tapi lewat cara aku bersikap ke depannya.</p>

    </div>

    <div class="bloom-wrap">
      <svg class="bloom" viewBox="0 0 100 100">
        <g transform="translate(50,50)">
          <path class="petal" d="M0,-6 C14,-24 34,-14 26,4 C34,-2 40,20 20,22 C30,32 10,42 0,26 C-10,42 -30,32 -20,22 C-40,20 -34,-2 -26,4 C-34,-14 -14,-24 0,-6 Z" opacity="0.95"/>
          <circle r="8" fill="#c9a66b"/>
        </g>
      </svg>
    </div>

    <p class="signature">— aku, yang masih sayang kamu</p>

    <div class="ask">
      <h2>boleh dimaafin, nggak?</h2>
      <div class="btn-row">
        <button id="yes-btn">boleh, aku maafin kamu</button>
        <button id="no-btn">masih butuh waktu</button>
      </div>
      <div class="response" id="response" aria-live="polite"></div>
    </div>
  </main>

  <footer>dibuat dengan sepenuh hati.</footer>

<script>
  const sealScreen = document.getElementById('seal-screen');
  const sealBtn = document.getElementById('seal-btn');
  sealBtn.addEventListener('click', () => {
    sealBtn.classList.add('melt');
    setTimeout(() => sealScreen.classList.add('opened'), 550);
    document.body.style.overflow = 'auto';
  });
  document.body.style.overflow = 'hidden';
  setTimeout(() => { document.body.style.overflow = 'auto'; }, 4000);

  const revealEls = document.querySelectorAll('.letter p, .signature, .bloom, .ask h2, .btn-row');
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('show'); });
  }, { threshold: 0.35 });
  revealEls.forEach(el => io.observe(el));

  const yesBtn = document.getElementById('yes-btn');
  const noBtn = document.getElementById('no-btn');
  const btnRow = document.querySelector('.btn-row');
  const response = document.getElementById('response');

  yesBtn.addEventListener('click', () => {
    response.textContent = 'makasih ya udah mau maafin aku. peluk dari jauh 🤍';
  });

  function dodge(e){
    if (e.cancelable) e.preventDefault();
    const rowRect = btnRow.getBoundingClientRect();
    const btnRect = noBtn.getBoundingClientRect();
    const maxX = Math.max(0, rowRect.width - btnRect.width);
    const maxY = Math.max(0, rowRect.height - btnRect.height);
    const newX = Math.random() * maxX;
    const newY = Math.random() * maxY;
    noBtn.style.left = newX + 'px';
    noBtn.style.top = newY + 'px';
    noBtn.style.transform = 'none';
  }
  ['mouseenter','pointerdown','touchstart','focus'].forEach(evt => {
    noBtn.addEventListener(evt, dodge, { passive:false });
  });
</script>
</body>
</html>
